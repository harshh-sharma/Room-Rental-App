// DATABASE CONNECTION
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PRISMA CLIENT
generator client {
  provider = "prisma-client-js"
}


// ENUMS
enum RoomEnum {
  PG
  Single
}

enum PaymentMethod {
  MANUAL
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserRole {
  OWNER
  RENTER
  ADMIN
}

enum EndRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

///////////////////////
// USER
///////////////////////
model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String

  isEmailVerified Boolean @default(false)
  emailVerifyToken String?
  emailVerifyExpiry DateTime?

  role       UserRole   @default(RENTER)

  properties Property[]

  ownerAgreements   Agreement[] @relation("OwnerAgreements")
  renterAgreements  Agreement[] @relation("RenterAgreements")
}

///////////////////////
// PROPERTY
///////////////////////
model Property {
  id           Int      @id @default(autoincrement())
  propertyName String

  address      String
  city         String
  state        String
  pincode      String

  latitude     Float?   
  longitude    Float?   

  isPublic     Boolean  @default(true)

  ownerId      Int
  owner        User     @relation(fields: [ownerId], references: [id])

  rooms        Room[]
  agreements   Agreement[]
}

///////////////////////
// ROOM
///////////////////////
model Room {
  id          Int      @id @default(autoincrement())
  roomNumber  String
  roomType    RoomEnum
  capacity    Int

  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id])

  agreements  Agreement[]

   @@unique([propertyId, roomNumber])
}

///////////////////////
// AGREEMENT
///////////////////////
model Agreement {
  id            Int      @id @default(autoincrement())

  ownerId       Int
  renterId      Int   

  propertyId    Int
  roomId        Int

  rent          Float
  deposit       Float?

  startDate     DateTime
  endDate       DateTime?

  isActive      Boolean  @default(true)

  endRequestStatus EndRequestStatus @default(NONE)
  endRequestDate   DateTime?

  createdAt     DateTime @default(now())

  owner         User     @relation("OwnerAgreements", fields: [ownerId], references: [id])
  renter        User     @relation("RenterAgreements", fields: [renterId], references: [id])

  property      Property @relation(fields: [propertyId], references: [id])
  room          Room     @relation(fields: [roomId], references: [id])

  bills         Bill[]

   @@index([roomId, isActive])
}

///////////////////////
// BILL
///////////////////////
model Bill {
  id          Int        @id @default(autoincrement())
  agreementId Int
  amount      Float
  dueDate     DateTime

  agreement   Agreement  @relation(fields: [agreementId], references: [id])
  payments    Payment[]
}

///////////////////////
// PAYMENT
///////////////////////
model Payment {
  id             Int            @id @default(autoincrement())
  billId         Int
  amount         Float

  method         PaymentMethod
  status         PaymentStatus  @default(PENDING)

  razorpayTxnId  String?        // optional (only for Razorpay)

  createdAt      DateTime       @default(now())

  bill           Bill           @relation(fields: [billId], references: [id])
}