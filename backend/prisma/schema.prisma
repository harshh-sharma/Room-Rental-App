// DATABASE CONNECTION
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// PRISMA CLIENT
generator client {
  provider = "prisma-client-js"
}


// ENUMS
enum RoomEnum {
  PG
  Single
}

enum PaymentMethod {
  MANUAL
  RAZORPAY
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum UserRole {
  OWNER
  RENTER
  ADMIN
}

enum EndRequestStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
}

enum ReadingStatus {
  PENDING
  APPROVED
  REJECTED
}

///////////////////////
// USER
///////////////////////
model User {
  id         Int        @id @default(autoincrement())
  name       String
  email      String     @unique
  password   String

  isEmailVerified Boolean @default(false)
  emailVerifyToken String?
  emailVerifyExpiry DateTime?

  role       UserRole   @default(RENTER)

  properties Property[]

  ownerAgreements   Agreement[] @relation("OwnerAgreements")
  renterAgreements  Agreement[] @relation("RenterAgreements")
}

///////////////////////
// PROPERTY
///////////////////////
model Property {
  id           Int      @id @default(autoincrement())
  propertyName String

  address      String
  city         String
  state        String
  pincode      String

  latitude     Float?   
  longitude    Float?   

  isPublic     Boolean  @default(true)

  ownerId      Int
  owner        User     @relation(fields: [ownerId], references: [id])

  rooms        Room[]
  agreements   Agreement[]
}

///////////////////////
// ROOM
///////////////////////
model Room {
  id          Int      @id @default(autoincrement())
  roomNumber  String
  roomType    RoomEnum
  capacity    Int

  propertyId  Int
  property    Property @relation(fields: [propertyId], references: [id])

  agreements  Agreement[]

   @@unique([propertyId, roomNumber])
}

///////////////////////
// AGREEMENT
///////////////////////
model Agreement {
  id            Int      @id @default(autoincrement())

  ownerId       Int
  renterId      Int   

  propertyId    Int
  roomId        Int

  rent          Float
  deposit       Float?

  electricityRate Float?      // ₹ per unit
  dueDay          Int         // e.g. 5

  fixedCharges   Json?        // dynamic key-value

  lastPaidMonth Int?
lastPaidYear  Int?

  startDate     DateTime
  endDate       DateTime?

  isActive      Boolean  @default(true)

  endRequestStatus EndRequestStatus @default(NONE)
  endRequestDate   DateTime?

  createdAt     DateTime @default(now())

  owner         User     @relation("OwnerAgreements", fields: [ownerId], references: [id])
  renter        User     @relation("RenterAgreements", fields: [renterId], references: [id])

  property      Property @relation(fields: [propertyId], references: [id])
  room          Room     @relation(fields: [roomId], references: [id])

  bills         Bill[]
  meterReadings MeterReading[]

  @@index([roomId, isActive])
}

///////////////////////
// BILL
///////////////////////
model Bill {
  id          Int      @id @default(autoincrement())

  agreementId Int

  billMonth   Int
  billYear    Int

  rentAmount        Float
  electricityRate   Float?     
  electricityUnits  Float?     
  electricityAmount Float?

  fixedCharges      Json?      
  extraCharges      Json?   

  totalAmount Float

  dueDate     DateTime
  status      BillStatus @default(PENDING)

  calculationType String // "ACTUAL" | "AUTO_APPROVED" | "ESTIMATED"

  createdAt   DateTime @default(now())

  agreement   Agreement @relation(fields: [agreementId], references: [id])
  payments    Payment[]

  @@unique([agreementId, billMonth, billYear])
}



///////////////////////
// Meter Reading
///////////////////////
model MeterReading {
  id            Int      @id @default(autoincrement())
  agreementId   Int

  units         Float
  imageUrl      String?

  status        ReadingStatus @default(PENDING)
  rejectionNote String?

  usedInBill    Boolean  @default(false)

  createdAt     DateTime @default(now())

  agreement     Agreement @relation(fields: [agreementId], references: [id])

  @@index([agreementId, createdAt])
}

///////////////////////
// PAYMENT
///////////////////////
model Payment {
  id             Int            @id @default(autoincrement())
  billId         Int
  amount         Float

  method         PaymentMethod
  status         PaymentStatus  @default(PENDING)

  razorpayTxnId  String?        // optional (only for Razorpay)

  createdAt      DateTime       @default(now())

  bill           Bill           @relation(fields: [billId], references: [id])
}